# AI Customer Support Agent Environment Configuration Template
# Copy this file to .env and adjust credentials as appropriate.

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ai_customer_support?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_mysql_password

# Backend Server Configuration
PORT=8080

# Security / JWT Configuration (Base64 encoded, at least 256-bit key)
JWT_SECRET=generate_a_unique_base64_secret_for_each_environment
JWT_EXPIRATION_MS=86400000

# Allowed CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Environment Configuration (React / Vite)
VITE_API_BASE_URL=http://localhost:8080

# Demo data is off by default; enable only for local development or tests.
SEED_DEMO_DATA=false
DEMO_PASSWORD=

# Optional one-time production administrator bootstrap. Set both together, then remove both after creation.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
